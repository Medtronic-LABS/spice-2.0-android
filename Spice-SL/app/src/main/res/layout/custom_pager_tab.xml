<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_medium_blue_bg"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingTop="@dimen/_15sdp">

        <TextView
            android:id="@+id/tvTabStart"
            style="@style/FollowUpTextView"
            android:layout_height="wrap_content"
            android:background="@drawable/left_mh_view_selector"
            android:gravity="center"
            android:padding="@dimen/_12sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_color_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTabSecond"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTabSecond"
            style="@style/FollowUpTextView"
            android:layout_height="wrap_content"
            android:background="@drawable/mental_health_button_bg"
            android:gravity="center"
            android:padding="@dimen/_12sdp"
            android:ellipsize="end"
            android:maxLines="1"

            android:textColor="@color/text_color_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTabMiddle"
            app:layout_constraintStart_toEndOf="@id/tvTabStart"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTabMiddle"
            style="@style/FollowUpTextView"
            android:layout_height="wrap_content"
            android:background="@drawable/mental_health_button_bg"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"

            android:padding="@dimen/_12sdp"
            android:textColor="@color/text_color_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTabFourth"
            app:layout_constraintStart_toEndOf="@id/tvTabSecond"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTabFourth"
            style="@style/FollowUpTextView"
            android:layout_height="wrap_content"
            android:background="@drawable/right_mh_view_selector"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="@dimen/_12sdp"
            android:textColor="@color/text_color_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvTabMiddle"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</HorizontalScrollView>
