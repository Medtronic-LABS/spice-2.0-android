<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    android:clickable="false"
    android:focusable="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPatient"
        style="@style/CardView_Style"
        android:layout_width="match_parent"
        android:background="?attr/selectableItemBackground"
        android:clickable="false"
        android:focusable="false"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPatientRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/default_color_bg"
            android:padding="@dimen/_20sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPatientName"
                style="@style/TextStyle_Bold_16_NoBG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:gravity="start"
                android:textColor="@color/secondary_black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Serena Kamara - 38 - F" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/startGuideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.37" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/centreGuideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.50" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/endGuideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.44" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelService"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/service_name"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/startGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPatientName" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelServiceSeparator"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/separator_colon"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelService" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvService"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="@dimen/_0dp"
                android:paddingEnd="@dimen/_8sdp"
                android:textColor="@color/secondary_black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="5"
                app:layout_constraintStart_toEndOf="@id/endGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelService"
                tools:text="ANC" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvLabelService,tvLabelServiceSeparator,tvService" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelServiceDate"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/service_date"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/startGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLabelService" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelServiceDateSeparator"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/separator_colon"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelServiceDate" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvServiceDate"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="@dimen/_0dp"
                android:paddingEnd="@dimen/_8sdp"
                android:textColor="@color/secondary_black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="5"
                app:layout_constraintStart_toEndOf="@id/endGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelServiceDate"
                tools:text="ANC" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupServiceDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvLabelServiceDate,tvLabelServiceDateSeparator,tvServiceDate" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelReason"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/reason"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/startGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLabelServiceDate" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelReasonSeperator"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/separator_colon"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelReason" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvReason"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="@dimen/_0dp"
                android:paddingEnd="@dimen/_8sdp"
                android:textColor="@color/secondary_black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="5"
                app:layout_constraintStart_toEndOf="@id/endGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelReason"
                tools:text="ANC Visit 3" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvLabelReason,tvLabelReasonSeperator,tvReason" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelMembersRegistered"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/patient_status"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/startGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLabelReason" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMembersRegisteredSeperator"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/separator_colon"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelMembersRegistered" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPatientStatus"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/endGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelMembersRegistered"
                tools:text="On Treatment" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupPatientStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvLabelMembersRegistered,tvMembersRegisteredSeperator,tvPatientStatus" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelNextVisitDate"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/next_visit_date"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/startGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLabelMembersRegistered" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNextVisitDateSeparator"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/separator_colon"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelNextVisitDate" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNextVisitDate"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/endGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelNextVisitDate"
                tools:text="24/05/2026" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabelLastVisitDate"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/last_visit_date"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/startGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLabelNextVisitDate" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLastVisitDateSeparator"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/separator_colon"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelLastVisitDate" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLastVisitDate"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/endGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLabelLastVisitDate"
                tools:text="20/05/2026" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupVisitDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvLabelNextVisitDate,tvNextVisitDateSeparator,tvNextVisitDate,tvLabelLastVisitDate,tvLastVisitDateSeparator,tvLastVisitDate" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLastCallAtLabel"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/called_at"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/startGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvLabelLastVisitDate" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLastCallAtLabelSeperator"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/separator_colon"
                android:textColor="@color/charcoal_grey"
                app:layout_constraintEnd_toStartOf="@id/endGuideline"
                app:layout_constraintStart_toEndOf="@id/startGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLastCallAtLabel" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLastCallAtValue"
                style="@style/TextStyle_Regular_16_Blue"
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/endGuideline"
                app:layout_constraintTop_toTopOf="@+id/tvLastCallAtLabel"
                tools:text="3:44 pm" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupLastCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvLastCallAtLabel,tvLastCallAtLabelSeperator,tvLastCallAtValue" />

            <LinearLayout
                android:id="@+id/llButtonView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLastCallAtLabel">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/assessmentButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/purple_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/_24sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:src="@drawable/ic_follow_up_assessment" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/callButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_18sdp"
                    android:background="@drawable/call_button_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/_24sdp"
                    android:paddingVertical="@dimen/_10sdp"
                    android:src="@drawable/ic_call"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLastCallAtLabel" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRemainingCount"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/a_red_error"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:layout_marginTop="@dimen/_minus5sdp"
                android:layout_marginEnd="@dimen/_minus5sdp"
                app:layout_constraintEnd_toEndOf="@id/llButtonView"
                app:layout_constraintTop_toTopOf="@id/llButtonView"
                tools:text="5" />

            <TextView
                android:id="@+id/tvDueInformation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/llButtonView"
                app:layout_constraintEnd_toEndOf="@id/centreGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLastCallAtLabel"
                app:layout_constraintTop_toTopOf="@id/llButtonView"
                tools:text="2 days, Overdue" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
