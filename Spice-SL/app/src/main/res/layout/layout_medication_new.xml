<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_6sdp"
        android:padding="@dimen/_16sdp"
        app:alignItems="center"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="flex_start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_120sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMedicationNameTitle"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/name"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:id="@+id/tvMedicationName"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_8sdp"
                android:minHeight="@dimen/_40sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                tools:text="Fevago" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_80sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDosageTitle"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/dosage"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDosage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_margin="@dimen/_8sdp"
                android:background="@drawable/et_background"
                android:inputType="numberDecimal"
                android:maxLength="10"
                android:paddingHorizontal="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                android:visibility="gone"
                tools:text="0.5" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDosage"
            style="@style/MR_Field_Style"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_8sdp"
            android:gravity="center"
            android:minWidth="@dimen/_120sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_14ssp"
            android:visibility="gone"
            tools:text="0.5" />


        <TextView
            android:id="@+id/tvUnitVal"
            style="@style/MR_Field_Style"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_8sdp"
            android:gravity="center"
            android:minWidth="@dimen/_120sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_14ssp"
            android:visibility="gone"
            tools:text="0.5" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_80sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUnitTitle"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/unit"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/tvUnit"
                style="@style/Form_Spinner_Style"
                android:layout_width="@dimen/_120sdp"
                android:layout_margin="@dimen/_8sdp"
                android:minHeight="@dimen/_40sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                tools:text="PRN" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/llForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_80sdp"
            android:visibility="gone"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvForm"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp"
                android:text="@string/form" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerForm"
                style="@style/Form_Spinner_Style"
                android:layout_width="@dimen/_120sdp"
                android:layout_margin="@dimen/_8sdp"
                android:minHeight="@dimen/_40sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                tools:text="PRN" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_120sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFrequencyTitle"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/frequency"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerFrequency"
                style="@style/Form_Spinner_Style"
                android:layout_width="@dimen/_120sdp"
                android:layout_margin="@dimen/_8sdp"
                android:minHeight="@dimen/_40sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                tools:text="PRN" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_120sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvInstructionTitle"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/instructions"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/etInstruction"
                style="@style/MR_Field_Style"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_8sdp"
                android:layout_weight="1"
                android:background="@drawable/et_background"
                android:minWidth="@dimen/_120sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                tools:text="Before food" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_120sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPrescribedTitle"
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/duration"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etPrescribedDays"
                style="@style/MR_Field_Style"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:layout_margin="@dimen/_8sdp"
                android:background="@drawable/et_background"
                android:digits="0123456789"
                android:inputType="number"
                android:minWidth="@dimen/_120sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_14ssp"
                tools:text="30" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvPrescribedSince"
            style="@style/MR_Field_Style"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:minWidth="@dimen/_120sdp"
            android:text="@string/separator_hyphen"
            android:textColor="@color/cobalt_blue"
            android:textSize="@dimen/_14ssp"
            android:visibility="gone"
            tools:text="-" />

        <ImageView
            android:id="@+id/ivResetMedication"
            android:layout_width="@dimen/_0dp"
            android:layout_height="@dimen/_38sdp"
            android:contentDescription="@string/reset_medication"
            android:src="@drawable/icon_reset_grey"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/_80sdp"
            android:orientation="vertical">

            <TextView
                style="@style/MR_Field_Style"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/duration"
                android:textColor="@color/table_title"
                android:textSize="@dimen/_14ssp"
                android:visibility="invisible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivRemoveMedication"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/button_white_background"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_close_error"
                android:tint="@color/cobalt_blue" />


        </LinearLayout>


    </com.google.android.flexbox.FlexboxLayout>

    <TextView
        android:id="@+id/tvMedicineErrorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_6sdp"
        android:fontFamily="@font/inter_regular"
        android:paddingHorizontal="@dimen/_12sdp"
        android:textColor="@color/a_red_error"
        android:textSize="@dimen/_12ssp"
        android:visibility="gone" />


    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/divider_color" />

</LinearLayout>
