<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/_20sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:background="@drawable/button_white_background"
                android:textColor="@color/cobalt_blue"
                android:textSize="14sp"
                android:gravity="center"
                android:text="@string/filter"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                android:drawableStart="@drawable/ic_filter_icon"
                android:drawablePadding="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="@+id/cgActivity"
                app:layout_constraintBottom_toBottomOf="@+id/cgActivity"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgActivity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/btnFilter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvFrom"
                style="@style/Form_Label_Style"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="@string/from"
                app:layout_constraintEnd_toStartOf="@id/tvTo"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cgActivity"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/tvTo"
                style="@style/Form_Label_Style"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:text="@string/to"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/tvFrom"
                app:layout_constraintTop_toTopOf="@id/tvFrom"
                tools:ignore="RtlSymmetry" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/etFrom"
                style="@style/Form_Input_Style_BG"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:drawableEnd="@drawable/dashboard_calendar"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="@string/dd_mmm_yyyy"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@id/tvFrom"
                app:layout_constraintStart_toStartOf="@id/tvFrom"
                app:layout_constraintTop_toBottomOf="@id/tvFrom" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/etTo"
                style="@style/Form_Input_Style_BG"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:drawableEnd="@drawable/dashboard_calendar"
                android:drawablePadding="@dimen/_5sdp"
                android:hint="@string/dd_mmm_yyyy"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="@id/tvTo"
                app:layout_constraintStart_toStartOf="@id/tvTo"
                app:layout_constraintTop_toBottomOf="@id/tvTo" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/customiseGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="tvFrom,tvTo,etFrom,etTo" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFollowUp"
                style="@style/CardView_Style"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etFrom">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFollowUp"
                        style="@style/Form_Label_Style_16"
                        android:layout_width="@dimen/_0dp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:text="@string/follow_up"
                        android:textColor="@color/secondary_black"
                        android:textSize="@dimen/_18ssp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvFollowUpValue"
                        app:layout_constraintEnd_toStartOf="@id/tvFollowUpValue"
                        app:layout_constraintStart_toStartOf="parent" />

                    <View
                        android:id="@+id/viewFollowUp"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/dashboard_card_drawable"
                        app:layout_constraintBottom_toBottomOf="@id/tvFollowUpValue"
                        app:layout_constraintEnd_toEndOf="@id/tvFollowUpValue"
                        app:layout_constraintStart_toStartOf="@id/tvFollowUpValue"
                        app:layout_constraintTop_toTopOf="@id/tvFollowUpValue" />

                    <TextView
                        android:id="@+id/tvFollowUpValue"
                        style="@style/Dashboard_Value_Style"
                        android:layout_width="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScreening"
                style="@style/CardView_Style"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardFollowUp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvScreening"
                        style="@style/Form_Label_Style_16"
                        android:layout_width="@dimen/_0dp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:text="@string/screened"
                        android:textColor="@color/secondary_black"
                        android:textSize="@dimen/_18ssp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvScreeningValue"
                        app:layout_constraintEnd_toStartOf="@id/tvScreeningValue"
                        app:layout_constraintStart_toStartOf="parent" />

                    <View
                        android:id="@+id/viewScreening"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/dashboard_card_drawable"
                        app:layout_constraintBottom_toBottomOf="@id/tvScreeningValue"
                        app:layout_constraintEnd_toEndOf="@id/tvScreeningValue"
                        app:layout_constraintStart_toStartOf="@id/tvScreeningValue"
                        app:layout_constraintTop_toTopOf="@id/tvScreeningValue" />

                    <TextView
                        android:id="@+id/tvScreeningValue"
                        style="@style/Dashboard_Value_Style"
                        android:layout_width="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReferred"
                style="@style/CardView_Style"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardScreening">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReferred"
                        style="@style/Form_Label_Style_16"
                        android:layout_width="@dimen/_0dp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:text="@string/people_referred"
                        android:textColor="@color/secondary_black"
                        android:textSize="@dimen/_18ssp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvReferredValue"
                        app:layout_constraintEnd_toStartOf="@id/tvReferredValue"
                        app:layout_constraintStart_toStartOf="parent" />

                    <View
                        android:id="@+id/viewReferred"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/dashboard_card_drawable"
                        app:layout_constraintBottom_toBottomOf="@id/tvReferredValue"
                        app:layout_constraintEnd_toEndOf="@id/tvReferredValue"
                        app:layout_constraintStart_toStartOf="@id/tvReferredValue"
                        app:layout_constraintTop_toTopOf="@id/tvReferredValue" />

                    <TextView
                        android:id="@+id/tvReferredValue"
                        style="@style/Dashboard_Value_Style"
                        android:layout_width="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAssessed"
                style="@style/CardView_Style"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardReferred">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAssessed"
                        style="@style/Form_Label_Style_16"
                        android:layout_width="@dimen/_0dp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:text="@string/assessed"
                        android:textColor="@color/secondary_black"
                        android:textSize="@dimen/_18ssp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvAssessedValue"
                        app:layout_constraintEnd_toStartOf="@id/tvAssessedValue"
                        app:layout_constraintStart_toStartOf="parent" />

                    <View
                        android:id="@+id/viewAssessed"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/dashboard_card_drawable"
                        app:layout_constraintBottom_toBottomOf="@id/tvAssessedValue"
                        app:layout_constraintEnd_toEndOf="@id/tvAssessedValue"
                        app:layout_constraintStart_toStartOf="@id/tvAssessedValue"
                        app:layout_constraintTop_toTopOf="@id/tvAssessedValue" />

                    <TextView
                        android:id="@+id/tvAssessedValue"
                        style="@style/Dashboard_Value_Style"
                        android:layout_width="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEnrolled"
                style="@style/CardView_Style"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAssessed">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEnrolled"
                        style="@style/Form_Label_Style_16"
                        android:layout_width="@dimen/_0dp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:text="@string/registered"
                        android:textColor="@color/secondary_black"
                        android:textSize="@dimen/_18ssp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvEnrolledValue"
                        app:layout_constraintEnd_toStartOf="@id/tvEnrolledValue"
                        app:layout_constraintStart_toStartOf="parent" />

                    <View
                        android:id="@+id/viewEnrolled"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/dashboard_card_drawable"
                        app:layout_constraintBottom_toBottomOf="@id/tvEnrolledValue"
                        app:layout_constraintEnd_toEndOf="@id/tvEnrolledValue"
                        app:layout_constraintStart_toStartOf="@id/tvEnrolledValue"
                        app:layout_constraintTop_toTopOf="@id/tvEnrolledValue" />

                    <TextView
                        android:id="@+id/tvEnrolledValue"
                        style="@style/Dashboard_Value_Style"
                        android:layout_width="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLinkedToCare"
                style="@style/CardView_Style"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardEnrolled">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLinkedToCare"
                        style="@style/Form_Label_Style_16"
                        android:layout_width="@dimen/_0dp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:text="@string/linked_to_care"
                        android:textColor="@color/secondary_black"
                        android:textSize="@dimen/_18ssp"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvLinkedToCareValue"
                        app:layout_constraintEnd_toStartOf="@id/tvLinkedToCareValue"
                        app:layout_constraintStart_toStartOf="parent" />

                    <View
                        android:id="@+id/viewLinkedToCare"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/dashboard_card_drawable"
                        app:layout_constraintBottom_toBottomOf="@id/tvLinkedToCareValue"
                        app:layout_constraintEnd_toEndOf="@id/tvLinkedToCareValue"
                        app:layout_constraintStart_toStartOf="@id/tvLinkedToCareValue"
                        app:layout_constraintTop_toTopOf="@id/tvLinkedToCareValue" />

                    <TextView
                        android:id="@+id/tvLinkedToCareValue"
                        style="@style/Dashboard_Value_Style"
                        android:layout_width="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
