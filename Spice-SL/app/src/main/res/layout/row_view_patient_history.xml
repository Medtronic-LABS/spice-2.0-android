<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNameAge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:textColor="@color/gray_black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Selina Begum - 41 - F" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clLabelTextViews"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLabelText"
            style="@style/bioDataTextStyleLabel"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:text="@string/national_id"
            app:layout_constraintEnd_toStartOf="@+id/percentageDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/bioDataTextStyleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/separator_colon"
            app:layout_constraintStart_toStartOf="@+id/percentageDivider"
            app:layout_constraintTop_toTopOf="@+id/tvLabelText" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvValueText"
            style="@style/bioDataTextStyle"
            android:layout_width="@dimen/_0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/percentageDivider"
            app:layout_constraintTop_toTopOf="@+id/tvLabelText"
            tools:text="1234479849" />


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/percentageDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.35" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
